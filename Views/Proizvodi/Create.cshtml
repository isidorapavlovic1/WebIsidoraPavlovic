@model WebIsidoraPavlovic.Models.Proizvod
<link rel="stylesheet" href="~/css/Custom.css" asp-append-version="true" />

<h2>Dodaj proizvod</h2>

<form asp-action="Create" enctype="multipart/form-data" method="post" class="form">
    <div class="mb-3">
        <label>Ime</label>
        <input asp-for="Ime" class="form-control" />
        <span asp-validation-for="Ime" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Opis</label>
        <textarea asp-for="Opis" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label>Cena (RSD)</label>
        <input asp-for="Cena" type="number" step="0.01" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Tip proizvoda</label>
        <select asp-for="Tip" class="form-select" asp-items="Html.GetEnumSelectList<WebIsidoraPavlovic.Models.TipProizvoda>()">
            <option value="">-- Izaberi tip --</option>
        </select>
    </div>

    <div class="mb-3">
        <label>Slika</label>
        <input asp-for="SlikaFile" type="file" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">Sačuvaj</button>
    <a asp-action="Index" class="btn btn-secondary">Nazad</a>
</form>
