@using WebIsidoraPavlovic.Models
@model WebIsidoraPavlovic.Models.Proizvod
<link rel="stylesheet" href="~/css/Custom.css" asp-append-version="true" />

<h2>Izmeni proizvod</h2>

<form asp-action="Edit" method="post" enctype="multipart/form-data" class="form">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Ime" class="form-label">Naziv</label>
        <input asp-for="Ime" class="form-control" />
        <span asp-validation-for="Ime" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Opis" class="form-label">Opis</label>
        <textarea asp-for="Opis" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="Cena" class="form-label">Cena (RSD)</label>
        <input asp-for="Cena" type="number" step="0.01" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Tip" class="form-label">Tip proizvoda</label>
        <select asp-for="Tip" class="form-select"
                asp-items="Html.GetEnumSelectList<TipProizvoda>()">
            <option value="">-- Izaberi tip --</option>
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Slika</label><br />
        @if (Model.Slika != null)
        {
            var base64 = Convert.ToBase64String(Model.Slika);
            <img src="data:image/png;base64,@base64" width="120" height="120" style="object-fit:cover;border-radius:6px;" />

            <br />
        }
        <input asp-for="SlikaFile" type="file" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">Sačuvaj izmene</button>
    <a asp-action="Index" class="btn btn-secondary">Nazad</a>
</form>
