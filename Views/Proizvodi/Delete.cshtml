@model WebIsidoraPavlovic.Models.Proizvod
<link rel="stylesheet" href="~/css/Custom.css" asp-append-version="true" />

<h2>Obriši proizvod</h2>

<div class="alert alert-warning">
    <p>Da li ste sigurni da želite da obrišete proizvod: <strong>@Model.Ime</strong>?</p>
</div>
<div class="text-start">

<div class="mb-3">
    <label>Tip:</label> @Model.Tip
</div>
<div class="mb-3">
    <label>Cena:</label> @Model.Cena.ToString("N2") RSD
</div>
<div class="mb-3">
    <label>Opis:</label> @Model.Opis
</div>
<div class="mb-3">
    @if (Model.Slika != null)
    {
        var base64 = Convert.ToBase64String(Model.Slika);
        <img src="data:image/png;base64,@base64" width="120" height="120" style="object-fit:cover;border-radius:6px;" />
    }
</div>

</div>
<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Obriši</button>
    <a asp-action="Index" class="btn btn-secondary">Nazad</a>
</form>
