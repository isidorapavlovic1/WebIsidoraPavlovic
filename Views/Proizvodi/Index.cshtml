@model IEnumerable<WebIsidoraPavlovic.Models.Proizvod>
<link rel="stylesheet" href="~/css/Custom.css" asp-append-version="true" />

<h2>Lista proizvoda</h2>

@if (User.IsInRole("ADMIN"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary mb-3">Dodaj novi proizvod <i class="bi bi-plus-circle"></i></a>
    </p>
}

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var p in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">
                @if (p.Slika != null)
                {
                    var base64 = Convert.ToBase64String(p.Slika);
                    var imgSrc = $"data:image/png;base64,{base64}";
                    <img src="@imgSrc" class="card-img-top" style="height:180px; object-fit:cover;" />
                }
                else
                {
                    <img src="/images/no-image.png" class="card-img-top" style="height:180px; object-fit:cover;" />
                }

                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@p.Ime</h5>
                    <p class="card-text mb-1"><strong>Tip:</strong> @p.Tip</p>
                    <p class="card-text mb-3"><strong>Cena:</strong> @p.Cena.ToString("N2") RSD</p>

                    <div class="mt-auto text-end">
                        <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-warning me-2">Detalji</a>

                        @if (User.IsInRole("USER"))
                        {
                            <form asp-controller="Korpa" asp-action="DodajUKorpu" method="post" class="d-inline">
                                <input type="hidden" name="proizvodId" value="@p.Id" />
                                <input type="hidden" name="kolicina" value="1" />
                                <button type="submit" class="btn btn-sm btn-success">Dodaj u korpu <i class="bi bi-bag-plus-fill"></i></button>
                            </form>
                        }

                        @if (User.IsInRole("ADMIN"))
                        {
                            <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-primary me-1">Izmeni <i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-danger">Obriši <i class="bi bi-trash3-fill"></i></a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
