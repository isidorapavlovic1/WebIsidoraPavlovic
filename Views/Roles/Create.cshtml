@using Microsoft.AspNetCore.Identity

<link rel="stylesheet" href="~/css/CustomRoles.css" asp-append-version="true" />

@model IdentityRole
<div class="row">
    <div class="col-md-6">
        <form method="post">
            <h1>Create new role</h1>
            <hr />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-floating" style="margin-bottom:10px;">
                <input asp-for="Name" class="form-control" aria-required="true" />
                <label asp-for="Name" style="color:black">Role name</label>

                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="row">
                <button type="submit" class="btn btn-primary">Save <i class="bi bi-plus-circle"></i></button>
            </div>
        </form>
    </div>
</div>