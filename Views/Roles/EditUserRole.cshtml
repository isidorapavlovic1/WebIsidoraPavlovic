@model WebIsidoraPavlovic.Models.ViewModels.EditUserRoleViewModel
<link rel="stylesheet" href="~/css/CustomRoles.css" asp-append-version="true" />

<h1>Promena uloga za <strong style="text-transform:lowercase; color:white;">@Model.UserName</strong></h1>

<form asp-action="EditUserRole" method="post">
    <input type="hidden" asp-for="UserId" />
    <table class="table">
        <thead>
            <tr><th>Uloga</th><th>Izabrana</th></tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Roles.Count; i++)
            {
                <tr>
                    <td>@Model.Roles[i].RoleName</td>
                    <td>
                        <input asp-for="@Model.Roles[i].Selected" type="checkbox" />
                        <input type="hidden" asp-for="@Model.Roles[i].RoleName" />
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <button type="submit" class="btn btn-success">Sačuvaj izmene</button>
</form>
